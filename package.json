{
  "name": "duck-hunt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small Duck Hunt style shooting game. PixiJS (WebGL with canvas fallback) and Howler (Web Audio with HTML5 Audio fallback).",
  "scripts": {
